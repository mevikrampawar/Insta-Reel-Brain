{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reel-brain-relay",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-28",
  "vars": {
    "FREE_REEL_LIMIT": 5,
    "WORKER_URL": "https://reel-brain-relay.vikrampawar5972.workers.dev"
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "a4822dda77a0431c9515ed60b20f0c97" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INGEST_QUEUE", "class_name": "IngestQueue" }
    ]
  },
  "migrations": [
    { "tag": "v1-ingest-queue", "new_sqlite_classes": ["IngestQueue"] }
  ]
}
